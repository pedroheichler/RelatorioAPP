# ── IA ──────────────────────────────────────────
# Groq (plano gratuito disponível) — console.groq.com/keys
GROQ_API_KEY=gsk_...

# Modelo usado na geração. Opcional — se a Groq aposentar o padrão,
# troque aqui sem mexer no código. Veja a lista em console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# ── Servidor ────────────────────────────────────
PORT=3000
